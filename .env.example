# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing admin session tokens (defaults to a safe auto-generated fallback if not provided)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key"

# TRANSACTIONAL EMAIL NOTIFICATION (Optional - if unconfigured, contact messages are securely saved in DB with 'email not delivered' state)
# Option A: Resend API
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="onboarding@resend.dev"
NOTIFICATION_TO_EMAIL="etomet2patrick@gmail.com"

# Option B: Standard SMTP (e.g., Brevo / SendGrid / Custom SMTP)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

